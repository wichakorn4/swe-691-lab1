def calculate_grade(scores): 
    # ตรวจสอบเพื่อป้องกัน Bug กรณีลิสต์ว่างเปล่า (ZeroDivisionError)
    if not scores: 
        return "N/A", 0.0

    total = 0 

    for score in scores: 
        total = total + score 

    average = total / len(scores) 

    if average >= 80: 

        grade = "A" 

    elif average >= 70: 

        grade = "B" 

    elif average >= 60: 

        grade = "C" 

    elif average >= 50: 

        grade = "D" 

    else: 

        grade = "F" 

    return grade, average 


# การใช้งานปกติ
scores = [85, 92, 78, 88, 95] 
print("ผลลัพธ์ปกติ:", calculate_grade(scores))

# ทดสอบกรณีลิสต์ว่างเปล่า เพื่อยืนยันว่าไม่มี Error แล้ว
empty_scores = []
print("ผลลัพธ์กรณีลิสต์ว่าง:", calculate_grade(empty_scores))
คำอธิบายการแก้ไข
เพิ่มคำสั่ง if not scores: ไว้ที่บรรทัดแรกของฟังก์ชัน เพื่อตรวจสอบว่าลิสต์ scores ไม่มีสมาชิกอยู่หรือไม่
หากเป็นลิสต์ว่าง ฟังก์ชันจะทำการ return "N/A", 0.0 ออกไปทันที ทำให้ข้ามขั้นตอนการหารด้วยจำนวนสมาชิก จึงช่วยป้องกันการเกิดข้อผิดพลาดรันไทม์ (Runtime Error) ได้อย่างปลอดภัยครับ
